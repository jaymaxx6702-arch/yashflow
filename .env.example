# YashFlow local/server environment example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only keys for shop integration. Never expose these as NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Or modern server secret key:
SUPABASE_SECRET_KEY=

# Shared only between Yash Laser Shop and YashFlow.
YASHFLOW_INTEGRATION_SECRET=
# Existing active employee UUID used as the audit actor for automated imports.
YASHFLOW_INTEGRATION_EMPLOYEE_ID=
