# YashFlow local/server environment example

# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration. Never expose these as NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Or modern server secret key:
SUPABASE_SECRET_KEY=

# Firebase Cloud Messaging server credentials
FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared only between Yash Laser Shop and YashFlow.
YASHFLOW_INTEGRATION_SECRET=
# Existing active employee UUID used as the audit actor for automated imports.
YASHFLOW_INTEGRATION_EMPLOYEE_ID=

# Android release signing material. Server-only.
YASHFLOW_ANDROID_KEYSTORE_BASE64=
YASHFLOW_ANDROID_KEYSTORE_PASSWORD=
YASHFLOW_ANDROID_KEY_ALIAS=
YASHFLOW_ANDROID_KEY_PASSWORD=

# Optional build-time Android app URL. GitHub Actions currently falls back to
# https://app2.yashlaser.in until the Vercel production cutover is complete.
YASHFLOW_APP_URL=
